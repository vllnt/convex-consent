{
  "name": "@vllnt/convex-consent",
  "version": "0.1.1",
  "description": "Append-only consent ledger (GDPR Art. 6/7) — record, withdraw, and gate consent per subject + purpose as a Convex component",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "files": [
    "dist",
    "src",
    "docs/API.md",
    "CHANGELOG.md",
    "llms.txt",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json && pnpm test:package",
    "build:codegen": "pnpm codegen && pnpm build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm build:codegen",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo --project tsconfig.ci.json && pnpm typecheck:tests",
    "typecheck:tests": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-tests.tsbuildinfo --project tsconfig.test.json",
    "lint": "pnpm check:agents && eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "generate:llms": "node scripts/generate-llms.mjs",
    "test:package": "node scripts/test-package.mjs && bash scripts/test-check-package-contents.sh",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test:coverage && pnpm typecheck && pnpm generate:llms",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\"",
    "codegen": "pnpm convex codegen --component-dir ./src/component"
  },
  "peerDependencies": {
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vllnt/eslint-config": "2.1.0",
    "@vllnt/typescript": "3.0.0",
    "convex": "^1.51.0",
    "convex-test": "^0.0.73",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "homepage": "https://oss.vllnt.com/packages/convex-consent",
  "bugs": {
    "url": "https://github.com/vllnt/convex-consent/issues"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-consent"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "convex",
    "convex-component",
    "consent",
    "gdpr",
    "privacy"
  ],
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "handlebars@<4.7.10": "^4.7.10",
      "deepmerge-ts@<8.0.0": "^8.0.2"
    }
  }
}
